<Window x:Class="SpaceLens.App.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:SpaceLens.App"
 Title="SpaceLens" Foreground="{DynamicResource Ink}" FontFamily="Segoe UI, Microsoft YaHei UI" FontSize="13" Icon="Assets/SpaceLens.ico" Width="1440" Height="900" MinWidth="1000" MinHeight="600" Background="{DynamicResource WindowBg}" WindowStartupLocation="CenterScreen" PreviewKeyDown="OnKeyDown" AllowDrop="True" Drop="OnDrop" UseLayoutRounding="True" TextOptions.TextFormattingMode="Display">
 <Border Background="{DynamicResource WindowBg}"><Grid><Grid.RowDefinitions><RowDefinition Height="36"/><RowDefinition Height="44"/><RowDefinition Height="42"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="27"/></Grid.RowDefinitions>
  <StackPanel Orientation="Horizontal" Margin="6,1"><Button x:Name="TaskModeButton" Content="任务管理器" Click="TaskModeClick" Style="{StaticResource MenuButton}"/><Button x:Name="DiskModeButton" Content="磁盘空间" Click="DiskModeClick" Style="{StaticResource MenuButton}" Background="{DynamicResource Selected}"/></StackPanel>
  <Grid x:Name="DiskToolbar" Grid.Row="1" Margin="8,3,8,4"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
   <StackPanel Orientation="Horizontal">
    <Button x:Name="SettingsButton" Content="&#xE713;" FontFamily="Segoe MDL2 Assets" ToolTip="设置" Click="SettingsClick" Style="{StaticResource IconButton}"/>
    <Separator Style="{StaticResource ToolSeparator}"/>
    <Button x:Name="BackButton" Content="&#xE72B;" FontFamily="Segoe MDL2 Assets" ToolTip="后退 · Alt+←" Click="BackClick" IsEnabled="False" Style="{StaticResource IconButton}"/>
    <Button x:Name="ForwardButton" Content="&#xE72A;" FontFamily="Segoe MDL2 Assets" ToolTip="前进 · Alt+→" Click="ForwardClick" IsEnabled="False" Style="{StaticResource IconButton}"/>
    <Button x:Name="UpButton" Content="&#xE74A;" FontFamily="Segoe MDL2 Assets" Click="UpClick" ToolTip="上一级 · Alt+↑" IsEnabled="False" Style="{StaticResource IconButton}"/>
    <Button x:Name="RootButton" Content="&#xE80F;" FontFamily="Segoe MDL2 Assets" Click="RootClick" ToolTip="根目录 · Alt+Home" IsEnabled="False" Style="{StaticResource IconButton}"/>
    <Button x:Name="RefreshButton" Content="&#xE72C;" FontFamily="Segoe MDL2 Assets" Click="RefreshClick" ToolTip="重新扫描 · F5" IsEnabled="False" Style="{StaticResource IconButton}"/>
    <Separator Style="{StaticResource ToolSeparator}"/>
    <Button Content="−" Click="LessDepthClick" Style="{StaticResource IconButton}" ToolTip="减少显示层级"/>
    <TextBlock x:Name="DepthText" Text="3 层" Margin="3,0" Foreground="{DynamicResource Muted}"/>
    <Button Content="＋" Click="MoreDepthClick" Style="{StaticResource IconButton}" ToolTip="增加显示层级"/>
    <Separator Style="{StaticResource ToolSeparator}"/>
    <Button x:Name="ChooseButton" ToolTip="选择文件夹" Click="ChooseClick" Style="{StaticResource IconButton}"><Path Data="M 1,5 L 7,5 L 9,7 L 17,7 L 17,17 L 1,17 Z" Width="18" Height="18" Stretch="Uniform" Stroke="{DynamicResource Ink}" StrokeThickness="1.2"/></Button>
   </StackPanel>
   <StackPanel x:Name="DrivePanel" Grid.Column="1" Orientation="Horizontal" Margin="8,0"/>
   <TextBox x:Name="PathBox" Grid.Column="2" ToolTip="输入目录后回车扫描；支持拖入文件夹" KeyDown="PathKeyDown" MinWidth="100"/>
   <Button Grid.Column="3" Content="扫描" Style="{StaticResource Primary}" Click="PathScanClick" Margin="6,0,0,0"/>
  </Grid>
  <Grid x:Name="DiskFilter" Grid.Row="2" Margin="9,2,9,6"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
   <TextBlock Text="筛选" Foreground="{DynamicResource Muted}" Margin="0,0,9,0"/>
   <Grid Grid.Column="1" Margin="0,0,7,0"><TextBox x:Name="SearchBox" TextChanged="SearchChanged" ToolTip="搜索当前目录及子目录中的文件名 · Ctrl+F"/><TextBlock x:Name="SearchPlaceholder" Text="文件名" Margin="14,0,14,2" VerticalAlignment="Center" Foreground="{DynamicResource Muted}" IsHitTestVisible="False"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding Text, ElementName=SearchBox}" Value=""><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock></Grid>
   <ComboBox x:Name="TypeFilter" Grid.Column="2" Width="108" SelectedIndex="0" SelectionChanged="FilterChanged" Margin="0,0,7,0"><ComboBoxItem>全部类型</ComboBoxItem><ComboBoxItem>视频</ComboBoxItem><ComboBoxItem>音频</ComboBoxItem><ComboBoxItem>图片</ComboBoxItem><ComboBoxItem>文档</ComboBoxItem><ComboBoxItem>程序</ComboBoxItem><ComboBoxItem>归档</ComboBoxItem><ComboBoxItem>代码</ComboBoxItem><ComboBoxItem>其他</ComboBoxItem></ComboBox>
   <ComboBox x:Name="SizeFilter" Grid.Column="3" Width="118" SelectedIndex="0" SelectionChanged="FilterChanged" Margin="0,0,7,0"><ComboBoxItem>不限大小</ComboBoxItem><ComboBoxItem>≥ 100 MiB</ComboBoxItem><ComboBoxItem>≥ 1 GiB</ComboBoxItem><ComboBoxItem>≥ 10 GiB</ComboBoxItem></ComboBox>
   <Button x:Name="LargestButton" Grid.Column="4" Content="大文件" Click="LargestClick" Margin="0,0,7,0"/>
   <Button x:Name="ListToggleButton" Grid.Column="5" Margin="0,0,12,0" Content="&#xE8FD;" FontFamily="Segoe MDL2 Assets" Click="ListToggleClick" Style="{StaticResource IconButton}" ToolTip="显示 / 隐藏列表 · F8"/>
   <CheckBox x:Name="LowImpactCheck" Grid.Column="6" Content="低占用" IsChecked="False" VerticalAlignment="Center" Margin="0,0,5,0" ToolTip="单路读取并限速；默认最多四路并行。机械盘建议勾选。"/>
  </Grid>
  <Grid x:Name="DiskMapPanel" Grid.Row="3" Margin="3,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*" MinWidth="300"/><ColumnDefinition x:Name="ListDividerColumn" Width="0"/><ColumnDefinition x:Name="ListColumn" Width="0"/></Grid.ColumnDefinitions>
   <Border Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Line}" BorderThickness="1"><Grid><Grid.RowDefinitions><RowDefinition Height="20"/><RowDefinition Height="*"/></Grid.RowDefinitions>
    <Border Background="{DynamicResource SurfaceAlt}"><DockPanel Margin="7,0"><TextBlock x:Name="MapRootName" Text="" FontSize="11"/><TextBlock x:Name="MapCaption" Text="" HorizontalAlignment="Right" Foreground="{DynamicResource Muted}" FontSize="11"/></DockPanel></Border>
    <local:TreemapView x:Name="Map" Grid.Row="1" ClipToBounds="True"/>
    <StackPanel x:Name="WelcomePanel" Grid.Row="1" VerticalAlignment="Center" HorizontalAlignment="Center"><TextBlock x:Name="EmptyHeading" Text="选择磁盘或文件夹" FontSize="15" Foreground="{DynamicResource Muted}" HorizontalAlignment="Center"/><TextBlock x:Name="EmptyText" Text="" Foreground="{DynamicResource Muted}" Margin="0,6,0,0" TextAlignment="Center" TextWrapping="Wrap" MaxWidth="400"/></StackPanel>
   </Grid></Border>
   <GridSplitter x:Name="ListDivider" Grid.Column="1" Width="5" HorizontalAlignment="Center" Background="Transparent" Visibility="Collapsed"/>
   <Border x:Name="ListPanel" Grid.Column="2" Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Line}" BorderThickness="1" Visibility="Collapsed"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
    <DockPanel Margin="8"><Button x:Name="ExportButton" DockPanel.Dock="Right" Content="导出" Click="ExportClick" IsEnabled="False" Padding="9,5" Margin="6,0,0,0"/><ComboBox x:Name="SortBox" DockPanel.Dock="Right" Width="112" SelectedIndex="0" SelectionChanged="FilterChanged"><ComboBoxItem>大小 ↓</ComboBoxItem><ComboBoxItem>名称 A–Z</ComboBoxItem><ComboBoxItem>修改时间 ↓</ComboBoxItem></ComboBox><TextBlock x:Name="ListCaption" Text="0 项" FontSize="11" TextWrapping="Wrap"/></DockPanel>
    <DataGrid x:Name="FileList" Grid.Row="1" AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Single" HeadersVisibility="Column" GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="{DynamicResource Line}" BorderThickness="0" Background="{DynamicResource Surface}" RowHeaderWidth="0" CanUserAddRows="False" CanUserDeleteRows="False" CanUserSortColumns="False" CanUserReorderColumns="False" EnableRowVirtualization="True" EnableColumnVirtualization="True" ScrollViewer.CanContentScroll="True" VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling" SelectionChanged="ListSelectionChanged" MouseDoubleClick="ListDoubleClick" PreviewMouseRightButtonDown="ListRightClick">
     <DataGrid.Columns><DataGridTemplateColumn Header="名称" Width="*"><DataGridTemplateColumn.CellTemplate><DataTemplate><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock Text="{Binding Icon}" Foreground="{Binding Color}" Margin="0,0,7,0" FontFamily="Segoe MDL2 Assets"/><TextBlock Grid.Column="1" Text="{Binding Name}" TextTrimming="CharacterEllipsis" ToolTip="{Binding RelativePath}"/></Grid></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn><DataGridTextColumn Header="大小" Binding="{Binding Size}" Width="100"/></DataGrid.Columns>
    </DataGrid>
   </Grid></Border>
  </Grid>
  <Grid x:Name="ScanPanel" Grid.Row="4" Visibility="Collapsed" Margin="9,5,9,3"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock x:Name="ScanPath" FontSize="11" TextTrimming="CharacterEllipsis"/><ProgressBar x:Name="ScanBar" Height="3" IsIndeterminate="False" Foreground="{DynamicResource Accent}" Background="{DynamicResource Track}" BorderThickness="0" Margin="0,5,10,0"/></StackPanel><Button x:Name="PauseButton" Grid.Column="1" Content="暂停" Click="PauseClick" Padding="13,5" Margin="6,0"/><Button x:Name="CancelButton" Grid.Column="2" Content="停止" Click="CancelClick" Padding="13,5"/></Grid>
  <Border x:Name="DiskFooter" Grid.Row="5" BorderBrush="{DynamicResource Line}" BorderThickness="0,1,0,0"><DockPanel Margin="8,0"><TextBlock x:Name="MemoryText" DockPanel.Dock="Right" FontSize="11" Foreground="{DynamicResource Muted}"/><Button x:Name="IssuesButton" DockPanel.Dock="Right" Content="0 异常" Click="IssuesClick" Padding="8,1" FontSize="11" Style="{StaticResource MenuButton}" ToolTip="查看扫描记录"/><TextBlock x:Name="LinkMetric" DockPanel.Dock="Right" Text="" Visibility="Collapsed"/><TextBlock x:Name="StatusText" Visibility="Collapsed" TextTrimming="CharacterEllipsis"/><StackPanel x:Name="StatusMetrics" Orientation="Horizontal"><TextBlock x:Name="StateMetric" Text="就绪" Margin="0,0,16,0"/><TextBlock x:Name="SizeMetric" Text="—" Margin="0,0,14,0" ToolTip="逻辑大小"/><TextBlock x:Name="FilesMetric" Text="0"/><TextBlock Text=" 文件" Margin="0,0,14,0"/><TextBlock x:Name="FoldersMetric" Text="0 文件夹" Margin="0,0,14,0"/><TextBlock x:Name="TimeMetric" Foreground="{DynamicResource Muted}"/></StackPanel></DockPanel></Border>
  <local:TaskManagerView x:Name="TaskView" Grid.Row="1" Grid.RowSpan="5" Visibility="Collapsed"/>
 </Grid></Border>
</Window>
